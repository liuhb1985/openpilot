<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="Curvature lead &amp; conformance" containers="1">
   <Container>
    <DockSplitter orientation="-" count="4" sizes="0.25;0.25;0.25;0.25">
     <DockArea name="target vs actual curvature (front-loading shows as target leading)">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="0.02" right="60" left="0" bottom="-0.02"/>
       <limitY/>
       <curve name="/modelV2/action/desiredCurvature" color="#1f77b4"/>
       <curve name="/controlsState/curvature" color="#d62728"/>
      </plot>
     </DockArea>
     <DockArea name="desired vs actual lateral acceleration">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="4" right="60" left="0" bottom="-4"/>
       <limitY/>
       <curve name="/controlsState/lateralControlState/torqueState/desiredLateralAccel" color="#1ac938"/>
       <curve name="/controlsState/lateralControlState/torqueState/actualLateralAccel" color="#ff7f0e"/>
      </plot>
     </DockArea>
     <DockArea name="lateral delay used by model">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="1" right="60" left="0" bottom="0"/>
       <limitY/>
       <curve name="/liveDelay/lateralDelay" color="#9467bd"/>
      </plot>
     </DockArea>
     <DockArea name="vehicle speed">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="40" right="60" left="0" bottom="0"/>
       <limitY/>
       <curve name="/carState/vEgo" color="#17becf"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Torque &amp; steering" containers="1">
   <Container>
    <DockSplitter orientation="-" count="4" sizes="0.25;0.25;0.25;0.25">
     <DockArea name="torque controller error terms">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="1" right="60" left="0" bottom="-1"/>
       <limitY/>
       <curve name="/controlsState/lateralControlState/torqueState/error" color="#d62728"/>
       <curve name="/controlsState/lateralControlState/torqueState/p" color="#1f77b4"/>
       <curve name="/controlsState/lateralControlState/torqueState/i" color="#1ac938"/>
       <curve name="/controlsState/lateralControlState/torqueState/f" color="#ff7f0e"/>
      </plot>
     </DockArea>
     <DockArea name="commanded vs delivered torque">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="1" right="60" left="0" bottom="-1"/>
       <limitY/>
       <curve name="/controlsState/lateralControlState/torqueState/output" color="#1f77b4"/>
       <curve name="/carControl/actuators/torque" color="#d62728"/>
       <curve name="/carOutput/actuatorsOutput/torque" color="#1ac938"/>
      </plot>
     </DockArea>
     <DockArea name="steering angle and rate (quantization / micro corrections)">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="30" right="60" left="0" bottom="-30"/>
       <limitY/>
       <curve name="/carState/steeringAngleDeg" color="#1f77b4"/>
       <curve name="/carState/steeringRateDeg" color="#d62728"/>
      </plot>
     </DockArea>
     <DockArea name="CAN yaw rate and lateral accel">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="2" right="60" left="0" bottom="-2"/>
       <limitY/>
       <curve name="/carState/yawRate" color="#9467bd"/>
       <curve name="/carState/latAccel" color="#f14cc1"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Estimator &amp; mode" containers="1">
   <Container>
    <DockSplitter orientation="-" count="4" sizes="0.25;0.25;0.25;0.25">
     <DockArea name="road roll and angle offset (IMU / paramsd path)">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="5" right="60" left="0" bottom="-5"/>
       <limitY/>
       <curve name="/liveParameters/roll" color="#1f77b4"/>
       <curve name="/liveParameters/angleOffsetDeg" color="#d62728"/>
       <curve name="/liveParameters/angleOffsetFastStd" color="#1ac938"/>
      </plot>
     </DockArea>
     <DockArea name="calibrated IMU yaw rate">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="1" right="60" left="0" bottom="-1"/>
       <limitY/>
       <curve name="/livePose/angularVelocityDevice/2" color="#9467bd"/>
      </plot>
     </DockArea>
     <DockArea name="lane-change state and desire">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="5" right="60" left="0" bottom="0"/>
       <limitY/>
       <curve name="/modelV2/meta/desire" color="#d62728"/>
       <curve name="/modelV2/meta/laneChangeState" color="#1f77b4"/>
      </plot>
     </DockArea>
     <DockArea name="lane line mode (0 means MPC bypassed)">
      <plot mode="TimeSeries" flip_x="false" flip_y="false" style="Lines">
       <range top="1" right="60" left="0" bottom="0"/>
       <limitY/>
       <curve name="/lateralPlan/useLaneLines" color="#17becf"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <!-- - - - - - - - - - - - - - - -->
 <Plugins>
  <plugin ID="DataLoad Rlog"/>
  <plugin ID="Cereal Subscriber"/>
 </Plugins>
 <!-- - - - - - - - - - - - - - - -->
</root>

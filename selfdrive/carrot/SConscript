# -*- coding: utf-8 -*-
Import("env", "common", "messaging", "visionipc", "cereal")

# 使用全局配置的克隆，避免污染其他模块
senv = env.Clone()

src = [
    "laned.cc",
]

# 链接库列表
# common: [_common, 'json11', 'zmq']
# messaging: [socketmaster, msgq, 'capnp', 'kj']
# visionipc & cereal: 构建生成的目标对象/库
libs = [visionipc, cereal] + messaging + common + [
    "OpenCL",
    "opencv_core",
    "opencv_imgproc",
    "opencv_imgcodecs",
    "pthread",
]

# 生成目标
senv.Program(
    target="laned",
    source=src,
    LIBS=libs,
)
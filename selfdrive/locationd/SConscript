# Import all necessary variables from the root SConstruct
Import('env', 'rednose', 'common', 'messaging', 'cereal', 'arch', 'transformations')
loc_libs = [common, messaging, cereal]

rednose_gen_dir = 'models/generated'
# Use absolute path for linker to find liblive_kf.so
gen_lib_path = Dir('#selfdrive/locationd/models/generated')

rednose_gen_deps = [
  "models/constants.py",
]

# Build EKF models
pose_ekf = env.RednoseCompileFilter(
  target='pose',
  filter_gen_script='models/pose_kf.py',
  output_dir=rednose_gen_dir,
  extra_gen_artifacts=[],
  gen_script_deps=rednose_gen_deps,
)
car_ekf = env.RednoseCompileFilter(
  target='car',
  filter_gen_script='models/car_kf.py',
  output_dir=rednose_gen_dir,
  extra_gen_artifacts=[],
  gen_script_deps=rednose_gen_deps,
)

# Build live_kf from local models (Required for locationd.cc)
live_ekf = env.RednoseCompileFilter(
  target='live_kf',
  filter_gen_script='models/live_kf.py',
  output_dir=rednose_gen_dir,
  extra_gen_artifacts=['live_kf_constants.h'],
)

# locationd build

lenv = env.Clone()
lenv.Append(LIBPATH=[gen_lib_path.abspath])
lenv.Append(LINKFLAGS=['-L'+gen_lib_path.abspath, '-Wl,-rpath=' + gen_lib_path.abspath])
lenv.Append(LIBPATH=[rednose_gen_dir])
# Crucial: Add absolute project root to CPPPATH for system headers
lenv.Append(CPPPATH=[Dir('#').abspath, '#selfdrive/locationd'])

if arch != "Darwin":
  lenv["LINKFLAGS"] += ["-Wl,--no-as-needed"]

# Correct suffix is .cpp as generated by rednose engine, plus the manual wrapper .cc
locationd_sources = ["locationd.cc", "models/live_kf.cc", "models/generated/live_kf.cpp"]
libs = ["live_kf", "ekf_sym"] + loc_libs + [transformations, 'zmq', 'capnp', 'kj', 'm', 'pthread', 'dl']

locationd = lenv.Program("locationd", locationd_sources, LIBS=libs)
lenv.Depends(locationd, rednose)
lenv.Depends(locationd, live_ekf)
lenv.Depends("models/live_kf.o", "models/generated/live_kf_constants.h")


locationd_jy62 = lenv.Program("locationd_jy62", ["locationd_jy62.cc", "models/live_kf.cc", "models/generated/live_kf.cpp"], LIBS=libs)
lenv.Depends(locationd_jy62, rednose)
lenv.Depends(locationd_jy62, live_ekf)
